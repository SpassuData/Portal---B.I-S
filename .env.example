# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commite o .env de verdade.

SECRET_KEY=gere-uma-chave-aleatoria-aqui
DEBUG=False
ALLOWED_HOSTS=seudominio.com,www.seudominio.com

# Power BI
DASHBOARD_RH=
DASHBOARD_FIN=
DASHBOARD_OP=

# Azure AD (login)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
# Precisa bater byte a byte com a Redirect URI cadastrada no App registration (tipo "Web").
# Local:      http://localhost:8000/auth/callback/
# Produção:   https://seudominio.com/auth/callback/
REDIRECT_URI=http://localhost:8000/auth/callback/
