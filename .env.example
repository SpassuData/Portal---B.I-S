# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commite o .env de verdade.

SECRET_KEY=gere-uma-chave-aleatoria-aqui
DEBUG=False
ALLOWED_HOSTS=seudominio.com,www.seudominio.com

# Power BI - People Analytics
DASHBOARD_PEOPLE_RH=
DASHBOARD_PEOPLE_CURRICULOS=
DASHBOARD_PEOPLE_TREINAMENTOS=
DASHBOARD_PEOPLE_PCDS=

# Power BI - DP Analytics
DASHBOARD_DP_FOLHA=
DASHBOARD_DP_ANALISE=

# Power BI - Performance & Resultados (REMAR)
DASHBOARD_REMAR_GERENTES=
DASHBOARD_REMAR_DIRETORIA=

# Power BI - Ramp Up & Performance
DASHBOARD_RAMPUP_ACOMPANHAMENTO=

# Power BI - Workforce Analytics
DASHBOARD_WORKFORCE_VISAO=
DASHBOARD_WORKFORCE_PRODUTIVIDADE=

# Azure AD (login)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
# Precisa bater byte a byte com a Redirect URI cadastrada no App registration (tipo "Web").
# Local:      http://localhost:8000/auth/callback/
# Produção:   https://seudominio.com/auth/callback/
REDIRECT_URI=http://localhost:8000/auth/callback/
